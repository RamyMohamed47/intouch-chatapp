{
  "name": "intouch",
  "version": "1.0.0",
  "description": "SaaS chat Application for communication",
  "keywords": [
    "SaaS",
    "Chatapp",
    "Communication"
  ],
  "homepage": "https://github.com/RamyMohamed47/intouch-chatapp#readme",
  "bugs": {
    "url": "https://github.com/RamyMohamed47/intouch-chatapp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RamyMohamed47/intouch-chatapp.git"
  },
  "license": "ISC",
  "author": "Ramy Mohamed",
  "type": "module",
  "main": "dist/server.js",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:shared && concurrently --kill-others-on-fail \"npm run dev --workspace @intouch/shared\" \"tsx watch src/server.ts\"",
    "clean": "rimraf dist packages/shared/dist",
    "build:shared": "npm run build --workspace @intouch/shared",
    "build": "npm run clean && npm run build:shared && tsc --project tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "npm run typecheck --workspace @intouch/shared && npm run build:shared && tsc --noEmit",
    "test": "npm run build:shared && tsx --test tests/*.test.ts packages/shared/tests/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate:remove-user-status": "tsx src/migrations/removeLegacyUserStatus.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@intouch/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jose": "^6.1.3",
    "mongoose": "^8.24.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.7.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
