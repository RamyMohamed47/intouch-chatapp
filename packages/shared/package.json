      "import": "./dist/users/index.js"
    },
    "./organizations": {
      "types": "./dist/organizations/index.d.ts",
      "import": "./dist/organizations/index.js"
    },
    "./memberships": {
      "types": "./dist/memberships/index.d.ts",
      "import": "./dist/memberships/index.js"
    },
    "./categories": {
      "types": "./dist/categories/index.d.ts",
      "import": "./dist/categories/index.js"
    },
    "./conversations": {
      "types": "./dist/conversations/index.d.ts",
      "import": "./dist/conversations/index.js"
    },
    "./messages": {
      "types": "./dist/messages/index.d.ts",
