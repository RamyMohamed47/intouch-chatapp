{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "auth/**/*.ts",
    "common/**/*.ts",
    "categories/**/*.ts",
    "chat-wallpapers/**/*.ts",
    "conversations/**/*.ts",
    "memberships/**/*.ts",
    "messages/**/*.ts",
    "organizations/**/*.ts",
    "realtime/**/*.ts",
    "search/**/*.ts",
    "uploads/**/*.ts",
    "users/**/*.ts",
    "voice/**/*.ts"
  ],
  "exclude": ["tests/**/*.ts"]
}
