{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true
  },
  "include": [
    "auth/**/*.ts",
    "categories/**/*.ts",
    "conversations/**/*.ts",
    "memberships/**/*.ts",
    "messages/**/*.ts",
    "organizations/**/*.ts"
  ],
  "exclude": ["tests/**/*.ts"]
}
