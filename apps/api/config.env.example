NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE=mongodb://127.0.0.1:27017/intouch?replicaSet=rs0
DB_PASSWORD=unused
SEARCH_PROVIDER=native
RUNTIME_STATE_PROVIDER=memory
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=intouch:development:v2
BACKGROUND_JOBS_PROVIDER=polling
STORAGE_PROVIDER=disabled
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=intouch-private
UPLOAD_DAILY_USER_BYTES=524288000
ORGANIZATION_STORAGE_BYTES=5368709120

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_ISSUER=intouch-api
ACCESS_TOKEN_AUDIENCE=intouch-client
LOGIN_THROTTLE_SECRET=replace-with-an-independent-32-byte-secret
LOGIN_ATTEMPT_LIMIT=10
LOGIN_ATTEMPT_WINDOW_MS=900000
LOGIN_ATTEMPT_COOLDOWN_MS=900000
AUTH_ACTION_TOKEN_SECRET=replace-with-an-independent-32-byte-secret
MAIL_OUTBOX_ENCRYPTION_SECRET=replace-with-an-independent-32-byte-secret

WEB_APP_URL=http://localhost:3001
MAIL_PROVIDER=smtp
BREVO_API_KEY=replace-with-brevo-api-key-for-mail-provider-brevo
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=unused
SMTP_PASSWORD=unused
MAIL_FROM_NAME=InTouch
MAIL_FROM_ADDRESS=noreply@intouch.local

CLIENT_ORIGINS=http://localhost:3001
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-web-client-secret
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/auth/oauth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT_URL=http://localhost:3001/auth/callback
