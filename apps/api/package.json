{
  "name": "@intouch/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsx watch src/server.ts",
    "build": "npm run clean && tsc --project tsconfig.build.json && node dist/docs/copy-openapi.js",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "migrate:remove-user-status": "tsx src/migrations/removeLegacyUserStatus.ts"
  },
  "dependencies": {
    "@intouch/shared": "*",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jose": "^6.1.3",
    "mongoose": "^8.24.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "swagger-ui-dist": "^5.32.13",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/semver": "^7.7.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
