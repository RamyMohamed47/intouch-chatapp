{
  "name": "@intouch/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/bootstrap.js",
  "scripts": {
    "clean": "rimraf dist",
    "dev": "tsx watch src/bootstrap.ts",
    "build": "npm run clean && tsc --project tsconfig.build.json && node dist/docs/copy-openapi.js",
    "start": "node --enable-source-maps dist/bootstrap.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "search:index:sync": "tsx src/migrations/syncSearchIndexes.ts",
    "storage:cors:sync": "tsx src/migrations/syncStorageCors.ts",
    "migrate:remove-user-status": "tsx src/migrations/removeLegacyUserStatus.ts",
    "migrate:remove-organization-logo-urls": "tsx src/migrations/removeLegacyOrganizationLogoUrls.ts",
    "migrate:verify-existing-users": "tsx src/migrations/verifyExistingUsers.ts",
    "migrate:channel-kinds": "tsx src/migrations/backfillChannelKinds.ts",
    "migrate:call-media-modes": "tsx src/migrations/backfillCallMediaModes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@intouch/shared": "*",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.72.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^6.3.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "file-type": "^21.0.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jose": "^6.1.3",
    "livekit-server-sdk": "^2.18.0",
    "mongoose": "^8.24.1",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "swagger-ui-dist": "^5.32.13",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^7.0.11",
    "@types/semver": "^7.7.1",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.1.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
