EXPO_PUBLIC_API_URL=http://192.168.1.2:3000
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=replace-with-google-web-client-id
# Optional. Use the DSN from the dedicated intouch-mobile Sentry project.
EXPO_PUBLIC_SENTRY_DSN=
# EAS file variable used by native Android push builds; do not commit the file.
# GOOGLE_SERVICES_JSON=./google-services.json
# Required before building for iOS.
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.replace-me
