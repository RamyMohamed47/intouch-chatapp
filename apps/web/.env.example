# Server-only origin used by the same-origin Next.js API proxy.
BACKEND_ORIGIN=http://localhost:3000

# Browser-visible Socket.IO origin. Socket connections use Bearer auth and CORS.
NEXT_PUBLIC_SOCKET_ORIGIN=http://localhost:3000

# Browser-visible LiveKit Cloud WebSocket endpoint. The API secret stays server-only.
NEXT_PUBLIC_LIVEKIT_URL=wss://replace-with-project.livekit.cloud

# Browser-visible R2 S3 origin used only for presigned private object requests.
NEXT_PUBLIC_R2_ORIGIN=https://replace-account-id.r2.cloudflarestorage.com

# Optional Sentry error monitoring. The auth token is build-only and must
# never use a NEXT_PUBLIC_ prefix.
SENTRY_DSN=https://replace-with-web-project-dsn
NEXT_PUBLIC_SENTRY_DSN=https://replace-with-web-project-dsn
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_ORG=replace-with-sentry-organization
SENTRY_PROJECT=intouch-web
SENTRY_AUTH_TOKEN=replace-with-source-map-upload-token
